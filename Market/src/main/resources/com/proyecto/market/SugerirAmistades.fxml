<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="505.0" prefWidth="764.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.proyecto.market.View.SugerirAmistadesController">

    <!-- Logo y título -->
    <HBox layoutX="20.0" layoutY="20.0" spacing="10" />

    <!-- Título de la sección -->
    <Label layoutX="315.0" layoutY="34.0" style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Sugerencias" />
     <ImageView fx:id="logoImageView" fitHeight="104.0" fitWidth="188.0" layoutY="-1.0">
      <image>
         <Image url="@../../../../../../../../../../Downloads/logoMarket.png" />
      </image>
   </ImageView>
   <Button layoutX="31.0" layoutY="442.0" mnemonicParsing="false" onAction="#volver" prefHeight="35.0" prefWidth="97.0" style="-fx-background-color: black; -fx-background-radius: 11;" text="Volver" textFill="WHITE" />
      <Button layoutX="495.0" layoutY="232.0" onAction="#enviarSolicitud" prefHeight="44.0" prefWidth="143.0" style="-fx-background-color: #89CFF0; -fx-text-fill: black; -fx-background-radius: 15;" text="Enviar Solicitud">
      <font>
         <Font name="System Bold" size="12.0" />
      </font>
   </Button>
   <ListView fx:id="sugerencias" layoutX="79.0" layoutY="97.0" prefHeight="313.0" prefWidth="361.0" />

</AnchorPane>
